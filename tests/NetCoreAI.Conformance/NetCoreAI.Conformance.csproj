<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>NetCoreAI conformance test suites: abstract xunit classes any IModelProvider, IVectorStore or IMetadataStore implementation must pass.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <IsTestProject>false</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NetCoreAI.Abstractions/NetCoreAI.Abstractions.csproj" />
    <ProjectReference Include="../../src/NetCoreAI.Core/NetCoreAI.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../docs/assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
