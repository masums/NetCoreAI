<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <Description>NetCoreAI embedded dashboard (Razor Components) and management API, mounted at /netcoreai.</Description>
    <!-- Assets are embedded so hosts need no static-file middleware; served from {path}/_content/. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NetCoreAI.Core/NetCoreAI.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
