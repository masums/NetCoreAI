<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>NetCoreAI GGUF model provider on LLamaSharp. Your project must also reference a native backend package — LLamaSharp.Backend.Cpu, or LLamaSharp.Backend.Cuda12 or LLamaSharp.Backend.Vulkan for GPU — because NuGet does not pass build targets through an intermediate package and that is how the native binaries are delivered.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../NetCoreAI.Core/NetCoreAI.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LLamaSharp" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
  </ItemGroup>
  <!-- LLamaSharp.Backend.Cpu injects its native binaries as Content items; consumers restore that package themselves, so never repack them. -->
  <Target Name="NetCoreAIStripNativeContent" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <ItemGroup>
      <Content Remove="@(Content)" Condition="'%(Extension)' == '.dll' or '%(Extension)' == '.so' or '%(Extension)' == '.dylib' or '%(Extension)' == '.metal'" />
    </ItemGroup>
  </Target>
</Project>
