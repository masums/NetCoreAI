<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>NVIDIA CUDA 12 native backend for NetCoreAI.Backend.Gguf. Add this package alongside NetCoreAI.Backend.Gguf and set the execution provider to Cuda.</Description>
    <!-- Native binaries only: this package carries no code of its own. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NetCoreAI.Backend.Gguf/NetCoreAI.Backend.Gguf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LLamaSharp.Backend.Cuda12" />
  </ItemGroup>
  <!-- The native backend package injects its binaries as Content; consumers restore it themselves. -->
  <Target Name="NetCoreAIStripNativeContent" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <ItemGroup>
      <Content Remove="@(Content)" Condition="'%(Extension)' == '.dll' or '%(Extension)' == '.so' or '%(Extension)' == '.dylib' or '%(Extension)' == '.metal'" />
    </ItemGroup>
  </Target>
</Project>
