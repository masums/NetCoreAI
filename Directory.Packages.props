<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <!-- Bumped together: keep every Microsoft.Extensions.AI* package on the same version -->
    <MeaiVersion>10.10.0</MeaiVersion>
    <AspNetCoreVersion>10.0.12</AspNetCoreVersion>
    <EfCoreVersion>10.0.12</EfCoreVersion>
    <LLamaSharpVersion>0.27.0</LLamaSharpVersion>
    <OnnxGenAIVersion>0.15.2</OnnxGenAIVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Model abstraction -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="$(MeaiVersion)" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="$(MeaiVersion)" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="$(MeaiVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="$(MeaiVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(AspNetCoreVersion)" />

    <!-- Providers -->
    <PackageVersion Include="OpenAI" Version="2.13.0" />
    <PackageVersion Include="Anthropic" Version="12.47.0" />
    <PackageVersion Include="OllamaSharp" Version="5.4.30" />
    <PackageVersion Include="LLamaSharp" Version="$(LLamaSharpVersion)" />
    <PackageVersion Include="LLamaSharp.Backend.Cpu" Version="$(LLamaSharpVersion)" />
    <PackageVersion Include="LLamaSharp.Backend.Cuda12" Version="$(LLamaSharpVersion)" />
    <PackageVersion Include="LLamaSharp.Backend.Vulkan" Version="$(LLamaSharpVersion)" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI" Version="$(OnnxGenAIVersion)" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />

    <!-- Storage -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="$(EfCoreVersion)" />

    <!-- Scheduling for data-source syncs -->
    <PackageVersion Include="Cronos" Version="0.13.0" />

    <!-- Document extraction (knowledge bases) -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="AngleSharp" Version="1.8.1" />

    <!-- Dashboard -->
    <PackageVersion Include="Markdig" Version="1.3.2" />

    <!-- Build -->
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />

    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.0" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(AspNetCoreVersion)" />
  </ItemGroup>
</Project>
